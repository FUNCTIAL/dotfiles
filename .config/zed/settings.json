     ]
    },
    {
     "paths": [
      "/home/functial/projects/functial.github.io/./"
     ]
    },
    {
     "paths": [
      "/home/functial/projects/horizon-calendar"
     ]
    },
    {
     "paths": [
      "/home/functial/projects/the-odin-project/./"
     ]
    },
    {
     "paths": [
      "/home/functial/projects/the-odin-project/odin-landing-page/./"
     ]
    }
   ]
  }
 ],
}
